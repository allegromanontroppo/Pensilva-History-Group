---
import { Image } from 'astro:assets';
import engineHouse from '../../src/images/engine-house.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <Image class="hero-image" src={engineHouse} alt="Painting of an engine house in the Pensilva landscape" widths={[720, 1100, 1600, 2200]} sizes="100vw" format="webp" quality={90} loading="eager" />
  <div class="hero-wash" aria-hidden="true"></div>
  <div class="shell hero-content">
    <p class="hero-kicker">Pensilva · St Ive · East Cornwall</p>
    <h1 id="hero-title">Pensilva & St Ive,<br /><em>remembered.</em></h1>
    <p class="hero-intro">A community archive of people, places, mines, photographs and memories from a remarkable corner of Cornwall.</p>
    <div class="hero-actions">
      <a class="button button--light" href="/search/">Search the archive</a>
      <a class="text-link text-link--light" href="/topics/">Browse by subject <span>→</span></a>
    </div>
  </div>
</section>
