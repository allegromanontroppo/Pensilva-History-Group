---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import type { ArchiveEntry } from '../lib/archive';
import { alphabetical } from '../lib/archive';
import { topicsFor } from '../lib/taxonomy';
const entries = alphabetical([...(await getCollection('people')), ...(await getCollection('places'))] as ArchiveEntry[]);
---
<BaseLayout title="Search the archive">
  <section class="search-masthead"><div class="shell narrow"><p class="eyebrow">Find a story</p><h1>Search the archive</h1><p class="listing-lede">Search names, places, mines, events and words in the original archive text.</p><label class="search-box"><span class="sr-only">Search the archive</span><input id="archive-search" type="search" placeholder="Try Hobhouse, Caradon, school…" autocomplete="off" /><span>Esc to clear</span></label><p id="search-status" class="search-status" aria-live="polite">Showing all {entries.length} stories.</p></div></section>
  <section class="section-pad search-results-section"><div class="shell image-card-grid">{entries.map(entry => { const haystack = [entry.data.title, entry.id, entry.body, ...topicsFor(entry).map(topic => topic.label)].join(' ').toLowerCase(); return <div class="search-result" data-search={haystack}><ArchiveCard entry={entry} /></div>; })}</div><div id="search-empty" class="shell search-empty" hidden><p class="eyebrow">No matches</p><h2>Nothing in the archive matches that search.</h2><p>Try a surname, a mine, a village or a broader word.</p></div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#archive-search');
    const items = [...document.querySelectorAll<HTMLElement>('.search-result')];
    const status = document.querySelector<HTMLElement>('#search-status');
    const empty = document.querySelector<HTMLElement>('#search-empty');
    const run = () => {
      if (!input) return;
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach(item => { const visible = terms.every(term => (item.dataset.search || '').includes(term)); item.hidden = !visible; if (visible) shown += 1; });
      if (status) status.textContent = terms.length ? `${shown} ${shown === 1 ? 'story' : 'stories'} found.` : `Showing all ${items.length} stories.`;
      if (empty) empty.hidden = shown !== 0;
      const url = new URL(window.location.href); terms.length ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q'); history.replaceState(null, '', url);
    };
    if (input) {
      const initial = new URLSearchParams(location.search).get('q');
      if (initial) input.value = initial;
      input.addEventListener('input', run);
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && input.value) { input.value = ''; run(); input.focus(); } });
      run();
    }
  </script>
</BaseLayout>
