---
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import '../styles/global.css';
import '../styles/lightbox.css';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
  type?: 'website' | 'article';
  image?: string;
  structuredData?: Record<string, unknown>;
}
const {
  title,
  description = 'The digital archive of Pensilva History Group: people, places, mines, photographs and memories from Pensilva and St Ive in east Cornwall.',
  transparentHeader = false,
  type = 'website',
  image,
  structuredData,
} = Astro.props;
const siteName = 'Pensilva History Group';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Pensilva & St Ive history`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const rootUrl = siteUrl.toString().replace(/\/$/, '');
const socialImage = image ? new URL(image, siteUrl).toString() : undefined;
const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: rootUrl,
  description: 'The digital archive of the Pensilva History Group.',
};
const schema = structuredData ? [websiteData, structuredData] : websiteData;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183038" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title ?? siteName} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <SkipLink />
    <SiteHeader transparent={transparentHeader} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-mark" href="/">Pensilva History Group</a>
          <p>Studying and recording the industrial and social history of Pensilva and the Parish of St Ive.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/topics/">Subjects</a><a href="/photographs/">Photographs</a><a href="/archive/">Archive</a><a href="/search/">Search</a>
        </nav>
      </div>
      <div class="shell footer-small">Community archive · Pensilva & St Ive, Cornwall</div>
    </footer>
    <ImageLightbox />
  </body>
</html>
