---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import type { ArchiveEntry } from '../lib/archive';
import { previewImage } from '../lib/images';
import { topics, entriesForTopic } from '../lib/taxonomy';

const people = await getCollection('people');
const places = await getCollection('places');
const entries = [...people, ...places] as ArchiveEntry[];
const emily = people.find(entry => entry.id === 'emily-hobhouse') as ArchiveEntry;
const emilyImage = previewImage(emily);
const featuredIds = ['pensilva-a-brief-history', 'south-caradon-mine', 'war-memorials-in-pensilva-and-st-ive'];
const featured = featuredIds.map(id => entries.find(entry => entry.id === id)).filter(Boolean) as ArchiveEntry[];
---
<BaseLayout transparentHeader>
  <Hero />

  <section class="home-index">
    <div class="shell archive-stats">
      <div><strong>{entries.length}</strong><span>archive stories</span></div>
      <div><strong>{people.length}</strong><span>people & memories</span></div>
      <div><strong>{places.length}</strong><span>places & landscape</span></div>
      <a href="/search/">Search every article <span>→</span></a>
    </div>
  </section>

  <section class="subject-section section-pad">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Explore the collection</p><h2>Six routes into the archive.</h2></div>
        <a class="text-link" href="/topics/">Browse all subjects <span>→</span></a>
      </div>
      <div class="topic-grid topic-grid--home">
        {topics.map((topic, index) => {
          const count = entriesForTopic(entries, topic.slug).length;
          return <a class="topic-card" href={`/topics/${topic.slug}/`}><span class="topic-index">0{index + 1}</span><h3>{topic.label}</h3><p>{topic.description}</p><span class="topic-count">{count} stories</span></a>;
        })}
      </div>
    </div>
  </section>

  <section class="emily-feature">
    <div class="shell emily-grid">
      <div class="emily-media">{emilyImage ? <img src={emilyImage} alt="Emily Hobhouse" loading="lazy" /> : null}<span class="emily-place">St Ive → South Africa</span></div>
      <div class="emily-copy">
        <p class="eyebrow">From St Ive to South Africa</p>
        <h2>Emily Hobhouse</h2>
        <p class="emily-lede">Born at St Ive Rectory in 1860, Emily Hobhouse became a humanitarian whose exposure of conditions in British concentration camps during the South African War made her a revered figure in South Africa.</p>
        <p>Her story is the most widely read part of this archive. Today the rectory where she grew up has been restored as <em>The Story of Emily</em>, a museum and immersive historical experience.</p>
        <div class="emily-actions"><a class="button" href="/people/emily-hobhouse/">Read our Emily Hobhouse archive</a><a class="text-link" href="https://thestoryofemily.com/" rel="external">The Story of Emily <span>↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="selected-section section-pad">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Selected from the archive</p><h2>A place to begin.</h2></div><a class="text-link" href="/archive/">See all {entries.length} stories <span>→</span></a></div>
      <div class="image-card-grid image-card-grid--three">{featured.map(entry => <ArchiveCard entry={entry} />)}</div>
    </div>
  </section>

  <section class="about-section section-pad">
    <div class="shell about-grid">
      <div class="about-heading"><p class="eyebrow">About the group</p><h2>Recording a community since 2011.</h2></div>
      <div class="about-copy">
        <p>Pensilva History Group was formed in January 2011 with sponsorship and assistance from the Caradon Hill Area Heritage Project (CHAHP), which was in turn funded by The Heritage Lottery. The Caradon Hill Area Heritage Project finished in March 2014; a Legacy Group was formed from the groups and organisations begun under the CHAHP umbrella.</p>
        <p>Our aim is to study and record the history, both industrial and social, of Pensilva and the Parish of St Ive, and to publish our research for anyone interested in this fascinating part of World Heritage Cornwall.</p>
        <p>Throughout the year the Group has held events and talks on different aspects of the area, with details traditionally published in the Parish Pump.</p>
      </div>
    </div>
    <div class="shell archive-film"><div><p class="eyebrow">From the original site</p><h3>A film of Pensilva</h3></div><div class="flex-video"><iframe src="https://www.youtube.com/embed/zMv0o9-exeI?rel=0" title="Pensilva history film" loading="lazy" allowfullscreen></iframe></div></div>
  </section>

  <section class="newspaper-strip">
    <div class="shell newspaper-grid"><div><p class="eyebrow">In the papers · 23 November 1871</p><p class="newspaper-source">Royal Cornwall Gazette, Falmouth Packet, Cornish Weekly News and General Advertiser</p></div><blockquote>“VAGRANTS — P.C. Lyle of the county constabulary has locked up two of these pests this week…”</blockquote></div>
  </section>
</BaseLayout>
